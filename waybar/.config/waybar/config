{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,

    "modules-left": [
        "custom/wlogout",
        "hyprland/window",
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
	"custom/lid",
        "custom/weather",
	"cpu",
        "memory",
        "network",
        "pulseaudio",
        "battery",
        "tray"
    ],

    "custom/wlogout": {
        "format": "\uf179",
        "on-click": "~/.local/bin/powermenu",
        "tooltip": false
    },
  
    "custom/lid": {
    	"exec": "~/.local/bin/lid-toggle status",
    	"signal": 8,
    	"interval": 30,
    	"on-click": "~/.local/bin/lid-toggle",
    	"tooltip": false
    },
    
    "custom/weather": {
    	"exec": "~/.local/bin/weather",
    	"interval": 900,
    	"tooltip": false,
    	"on-click": "kitty --hold -e curl -s 'wttr.in/?m'"
    },

    "hyprland/window": {
        "format": "{class}",
        "max-length": 40,
        "separate-outputs": true,
    	    "rewrite": {
        	"firefox": "Firefox",
        	"kitty": "Terminal"
    	}
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "show-special": false,
        "persistent-workspaces": [],
        "active-only": true
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}"
    },

    "cpu": {
        "interval": 2,
        "format": "\uf4bc {usage}%",
        "on-click": "kitty -e htop",
        "tooltip": false
    },

    "memory": {
        "interval": 5,
        "format": "\uefc5 {percentage}%",
        "format-alt": "\uefc5 {used:0.1f}GB",
        "tooltip": false
    },

    "network": {
        "format-wifi": "\udb81\udda9",
        "format-ethernet": "\uef44",
        "format-disconnected": "\udb81\uddaa",
        "format-linked": "\uef44 (No IP)",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\nIP: {ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "kitty -e nmtui"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\udb81\udd81",
        "format-bluetooth": "{icon} {volume}%",
        "format-bluetooth-muted": "\udb81\udd81",
        "tooltip": false,
        "format-icons": {
            "headphone": "\udb80\udecb",
            "headset": "\udb80\udece",
            "phone": "\uf2a0",
            "default": ["\udb81\udd7f", "\udb81\udd80", "\udb81\udd7e"]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "battery": {
        "interval": 30,
        "states": {
            "good": 50,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% \udb80\udc84",
        "format-plugged": "{capacity}% \udb81\udea5",
        "format-alt": "{time} {icon}",
        "format-icons": ["\udb80\udc7a", "\udb80\udc7b", "\udb80\udc7c", "\udb80\udc7d", "\udb80\udc7e", "\udb80\udc7f", "\udb80\udc80", "\udb80\udc81", "\udb80\udc82", "\udb80\udc79"]
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
